# Required for geocoding street addresses and cross-streets.
# Neighborhood names (e.g. "Wrigleyville", "Logan Square") work without a key.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CORS — set to your frontend URL in production (e.g. https://walk-path.vercel.app)
# Leave blank for localhost-only dev.
ALLOWED_ORIGINS=
