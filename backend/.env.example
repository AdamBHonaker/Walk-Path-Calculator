# LocationIQ hosted-geocoder fallback (https://locationiq.com).
# Free tier: 5,000 requests/day, OSM-based, permanent caching permitted.
# Only used when a query misses every local tier (neighborhoods, the
# SQLite addresses/intersections tables, and the curated POI files).
# Sign up at https://locationiq.com/register to get a key.
# Without a key, only local-tier queries resolve.
LOCATIONIQ_API_KEY=

# CORS — set to your frontend URL in production (e.g. https://walk-path.vercel.app).
# Leave blank for localhost-only dev.
ALLOWED_ORIGINS=

# Set to "true" only when running behind a trusted reverse proxy (Railway,
# Cloudflare, nginx, etc.) that terminates TLS and sets X-Forwarded-Proto.
# When enabled, the server will issue HSTS for requests where the proxy
# claims https. Leave unset/false for direct exposure.
TRUST_PROXY_HEADERS=

# Number of trusted reverse proxies in front of this service. The per-IP rate
# limiter reads the client IP from X-Forwarded-For at this depth, counted from
# the right (spoof-resistant — a client cannot forge the entries our own
# proxies append after it). Match it to the real deployment:
#   0  — direct exposure / no proxy (default). X-Forwarded-For is ignored and
#        the limiter keys on the TCP connection peer.
#   1  — one proxy in front, e.g. Railway's edge.
#   2  — two proxies, e.g. Cloudflare in front of Railway.
# A value larger than the real proxy depth lets clients spoof their key, so do
# not pad it. Leave at 0 for local dev.
TRUSTED_PROXY_HOPS=

# Deployment environment marker. Only "dev" / "development" / "local" allows
# DEV_TUNNEL_ORIGIN_REGEX (below) to take effect; any other value (including
# empty / unset) causes the backend to refuse the regex even if it is set.
# Leave unset in production. `npm run dev:tunnel` sets APP_ENV=development
# automatically in the spawned backend so you do not need to set it manually
# for the mobile-testing flow.
APP_ENV=

# Dev-only regex of CORS origins to accept in addition to ALLOWED_ORIGINS.
# Set automatically by `npm run dev:tunnel` (see docs/MOBILE_TESTING.md) to
# match per-session https://*.trycloudflare.com hostnames. Must be anchored
# with ^...$ — unanchored patterns are rejected. Only honored when
# APP_ENV ∈ {dev,development,local}. NEVER set this in production — it
# widens the CORS allowlist to a third-party-owned domain.
DEV_TUNNEL_ORIGIN_REGEX=

# Expected SHA-256 of backend/street_graph_igraph.pkl. When set, the backend
# verifies the file's digest before pickle.load and refuses to start on a
# mismatch (pickle deserialization is RCE-by-design, so the hash is the
# trust boundary). When unset, the backend logs a one-time warning and
# loads the pickle without verification — set this for production deploys.
# Compute with: `shasum -a 256 backend/street_graph_igraph.pkl`
# (or PowerShell: `Get-FileHash -Algorithm SHA256 backend\street_graph_igraph.pkl`)
STREET_GRAPH_SHA256=

# Chicago Data Portal (Socrata) — auth for the curated ingestion scripts in
# backend/scripts/ (build_libraries.py, build_schools_cps.py,
# build_police_stations.py, build_fire_stations.py). Register at
# https://data.cityofchicago.org and generate an API Key (ID + Secret).
# Each CDP_API_ENDPOINT_* points at the dataset's classic SODA URL:
# https://data.cityofchicago.org/resource/<4x4-id>.json
# Only required when running the ingestion scripts; not read at runtime.
CHICAGO_DATA_PORTAL_API_KEY_ID=
CHICAGO_DATA_PORTAL_API_KEY_SECRET=
CDP_API_ENDPOINT_FIRE_STATIONS=
CDP_API_ENDPOINT_POLICE_STATIONS=
CDP_API_ENDPOINT_Schools=
CDP_API_ENDPOINT_LIBRARIES=
# "CPD_Parks" (Chicago Park District park boundaries):
# https://data.cityofchicago.org/resource/ejsh-fztr.geojson
CDP_API_ENDPOINT_PARKS=
# "Divvy Bicycle Stations" (classic SODA roster, ~800+ stations):
# https://data.cityofchicago.org/resource/bbyy-e7gq.json
CDP_API_ENDPOINT_DIVVY=