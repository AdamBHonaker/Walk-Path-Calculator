# Environment / secrets
.env

# Legacy JSON geocode cache (retired -- runtime now uses
# data/chicago_geocode.db). Kept .deprecated locally as a paper trail.
geocode_cache.json
geocode_cache.json.deprecated

# Prebuilt release artifacts. The Dockerfile fetches all three from the
# `street-graph` GitHub release in a layer that sits BEFORE `COPY . .`
# (OPT-027), so any local copy of these files in the build context would
# overlay the curl-fetched bytes on the COPY step — including overwriting
# the SEC-001-verified pickle. Exclude them defensively so the developer's
# local copies cannot diverge from what the release produced.
street_graph.graphml
street_graph_igraph.pkl*
data/chicago_geocode.db
data/chicago_geocode.db-shm
data/chicago_geocode.db-wal
data/chicago_boundary.json

# OSMnx / routing cache (large files)
cache/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests
tests/
requirements-test.txt
